index=threathuntx sourcetype="thx:normalized:json" THXSource="network"
| where (lower(tostring(THXAction)) = "waf_decision") AND (lower(tostring(THXOutcome)) = "blocked") AND (lower(tostring(THXSignatureFamily)) = "injection")
| where NOT coalesce((lower(tostring(THXAuthorizedScan)) = "true"), false())
| table _time THXSource THXRecordId THXAction THXAuthorizedScan THXSignatureFamily THXOutcome THXUser

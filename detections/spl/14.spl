index=threathuntx sourcetype="thx:normalized:json" THXSource="windows"
| where (lower(tostring(THXEventId)) = "4624") AND (lower(tostring(THXAuthPackage)) = "ntlm") AND (lower(tostring(THXLogonType)) = "3") AND (lower(tostring(THXPeerZone)) = "workstations") AND (lower(tostring(THXAccountClass)) = "local_admin")
| where NOT coalesce((lower(tostring(THXApprovedChange)) = "true"), false())
| table _time THXSource THXRecordId THXEventId THXHost THXAccountClass THXApprovedChange THXAuthPackage THXLogonType THXPeerZone

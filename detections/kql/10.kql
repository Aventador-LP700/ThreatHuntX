// THX-10 WMI subscriptions | Review-only. Custom normalized schema.
THXNormalized_CL
| where THXSource == "windows"
| where THXEventId =~ "21"
| where THXAction =~ "wmi_binding"
| where THXNamespace =~ "root/subscription"
| where THXOwnerState =~ "unknown"
| project TimeGenerated, THXSource, THXRecordId, THXAction, THXEventId, THXHost, THXNamespace, THXOwnerState

{
  "additionalProperties": false,
  "properties": {
    "action": {
      "pattern": "^[a-z][a-z0-9_]{0,79}$",
      "title": "Action",
      "type": "string"
    },
    "alert_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alert Id"
    },
    "command_line": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Line"
    },
    "destination_ip": {
      "anyOf": [
        {
          "format": "ipvanyaddress",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Destination Ip"
    },
    "domain": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain"
    },
    "event_id": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "event_timestamp": {
      "format": "date-time",
      "title": "Event Timestamp",
      "type": "string"
    },
    "evidence_reference": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Evidence Reference",
      "type": "string"
    },
    "host": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Host",
      "type": "string"
    },
    "observables": {
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,79}$": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "title": "Observables",
      "type": "object"
    },
    "outcome": {
      "enum": [
        "success",
        "failure",
        "denied",
        "allowed",
        "blocked",
        "observed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "parent_process": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Process"
    },
    "process": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Process"
    },
    "record_id": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^\\d{2}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "enum": [
        "identity",
        "windows",
        "linux",
        "mail",
        "network",
        "cloud",
        "github",
        "kubernetes",
        "saas",
        "scanner"
      ],
      "title": "Source",
      "type": "string"
    },
    "source_ip": {
      "anyOf": [
        {
          "format": "ipvanyaddress",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Ip"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "technique_id": {
      "pattern": "^T\\d{4}(?:\\.\\d{3})?$",
      "title": "Technique Id",
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "user": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User"
    }
  },
  "required": [
    "event_timestamp",
    "source",
    "host",
    "event_id",
    "record_id",
    "action",
    "outcome",
    "evidence_reference",
    "scenario_id",
    "technique_id"
  ],
  "title": "Event",
  "type": "object"
}

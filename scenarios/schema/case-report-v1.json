{
  "$defs": {
    "Alert": {
      "additionalProperties": false,
      "properties": {
        "event_count": {
          "title": "Event Count",
          "type": "integer"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "group": {
          "title": "Group",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^\\d{2}$",
          "title": "Scenario Id",
          "type": "string"
        },
        "severity": {
          "title": "Severity",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "rule_id",
        "scenario_id",
        "title",
        "severity",
        "group",
        "first_seen",
        "last_seen",
        "event_count",
        "evidence"
      ],
      "title": "Alert",
      "type": "object"
    },
    "CaseAnalysis": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "unreviewed",
            "benign",
            "investigate",
            "escalate"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "hypothesis": {
          "maxLength": 700,
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "notes": {
          "maxLength": 4000,
          "title": "Notes",
          "type": "string"
        },
        "response": {
          "maxLength": 1500,
          "title": "Response",
          "type": "string"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Updated At"
        }
      },
      "required": [
        "hypothesis",
        "notes",
        "disposition",
        "response",
        "updated_at"
      ],
      "title": "CaseAnalysis",
      "type": "object"
    },
    "CaseScenario": {
      "additionalProperties": false,
      "properties": {
        "attack": {
          "$ref": "#/$defs/Mapping"
        },
        "id": {
          "pattern": "^\\d{2}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "attack"
      ],
      "title": "CaseScenario",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "pattern": "^[a-z][a-z0-9_]{0,79}$",
          "title": "Action",
          "type": "string"
        },
        "alert_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alert Id"
        },
        "command_line": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Line"
        },
        "destination_ip": {
          "anyOf": [
            {
              "format": "ipvanyaddress",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Ip"
        },
        "domain": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "event_id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "event_timestamp": {
          "format": "date-time",
          "title": "Event Timestamp",
          "type": "string"
        },
        "evidence_reference": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Evidence Reference",
          "type": "string"
        },
        "host": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "observables": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,79}$": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "title": "Observables",
          "type": "object"
        },
        "outcome": {
          "enum": [
            "success",
            "failure",
            "denied",
            "allowed",
            "blocked",
            "observed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "parent_process": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Process"
        },
        "process": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Process"
        },
        "record_id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^\\d{2}$",
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "enum": [
            "identity",
            "windows",
            "linux",
            "mail",
            "network",
            "cloud",
            "github",
            "kubernetes",
            "saas",
            "scanner"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_ip": {
          "anyOf": [
            {
              "format": "ipvanyaddress",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ip"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "technique_id": {
          "pattern": "^T\\d{4}(?:\\.\\d{3})?$",
          "title": "Technique Id",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "user": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        }
      },
      "required": [
        "event_timestamp",
        "source",
        "host",
        "event_id",
        "record_id",
        "action",
        "outcome",
        "evidence_reference",
        "scenario_id",
        "technique_id"
      ],
      "title": "Event",
      "type": "object"
    },
    "Mapping": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "enum": [
            "direct",
            "related"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "id": {
          "pattern": "^T\\d{4}(?:\\.\\d{3})?$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "rationale": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "tactics": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,79}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Tactics",
          "type": "array"
        },
        "url": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "url",
        "tactics",
        "confidence",
        "rationale"
      ],
      "title": "Mapping",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alerts": {
      "items": {
        "$ref": "#/$defs/Alert"
      },
      "title": "Alerts",
      "type": "array"
    },
    "analysis": {
      "$ref": "#/$defs/CaseAnalysis"
    },
    "case_id": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "fixture_mode": {
      "enum": [
        "baseline",
        "positive",
        "negative"
      ],
      "title": "Fixture Mode",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "limitations": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Limitations",
      "type": "string"
    },
    "mitigations": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Mitigations",
      "type": "array"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "rule_id": {
      "pattern": "^THX-\\d{2}$",
      "title": "Rule Id",
      "type": "string"
    },
    "scenario": {
      "$ref": "#/$defs/CaseScenario"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "synthetic_only": {
      "const": true,
      "title": "Synthetic Only",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "synthetic_only",
    "case_id",
    "scenario",
    "rule_id",
    "fixture_mode",
    "recorded_at",
    "generated_at",
    "analysis",
    "limitations",
    "mitigations",
    "alerts",
    "evidence"
  ],
  "title": "CaseReport",
  "type": "object"
}
